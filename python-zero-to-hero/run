#!/usr/bin/env bash
#
# One-click launcher for python-zero-to-hero (macOS / Linux / WSL / Git Bash).
#
#   ./run              your progress across all 21 days
#   ./run day04        grade Day 4
#   ./run day04 -v     grade Day 4 with full failure detail
#   ./run next         grade the first day you haven't finished
#   ./run doctor       check your setup
#   ./run plan         print the syllabus
#   ./run notebook     read the lessons as runnable notebooks in JupyterLab
#   ./run notebook day05   open Day 5's notebook straight away
#
# You do not have to care which Python is on your PATH, whether it is called
# `python` or `python3`, or whether pytest is installed. This script works all
# of that out, installs pytest if it is missing, and then hands over to
# check.py. Anything you type after `./run` is passed straight through.
#
# Override the interpreter if you want a specific one:
#   PZH_PYTHON=/usr/local/bin/python3.12 ./run doctor

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE" || exit 1

MIN="3.10"

# Is this candidate a real, working Python 3.10+?
#
# If so, print the absolute path of the actual interpreter binary. We ask the
# interpreter itself via sys.executable rather than trusting the name we were
# given, because a version manager's shim can pass a version check and then
# still fail to launch later (pyenv does exactly this). Resolving to the real
# binary once, up front, removes that whole class of problem.
usable() {
    local candidate="$1"
    [ -n "$candidate" ] || return 1
    command -v "$candidate" >/dev/null 2>&1 || [ -x "$candidate" ] || return 1

    local resolved
    resolved="$(
        "$candidate" -c 'import sys
if sys.version_info < (3, 10):
    raise SystemExit(1)
print(sys.executable)' 2>/dev/null
    )" || return 1

    [ -n "$resolved" ] && [ -x "$resolved" ] || return 1
    printf '%s\n' "$resolved"
}

find_python() {
    # An explicit choice wins, then a project virtualenv, then newest-first.
    local candidate resolved
    for candidate in \
        "${PZH_PYTHON:-}" \
        "$HERE/.venv/bin/python" \
        "$HERE/.venv/Scripts/python.exe" \
        python3.14 python3.13 python3.12 python3.11 python3.10 \
        python3 python py
    do
        if resolved="$(usable "$candidate")"; then
            printf '%s\n' "$resolved"
            return 0
        fi
    done

    # Last resort: an interpreter installed by a version manager but not wired
    # up to PATH. Newest first, so a stale 3.10 does not win over a 3.13.
    for candidate in $(printf '%s\n' "$HOME"/.pyenv/versions/*/bin/python3 | sort -rV); do
        if resolved="$(usable "$candidate")"; then
            printf '%s\n' "$resolved"
            return 0
        fi
    done

    return 1
}

PY="$(find_python)" || {
    cat >&2 <<EOF

  Could not find a working Python $MIN or newer.

  This course needs Python $MIN+. To fix it:
    * install it            -> see SETUP.md in this folder
    * or point me at one    -> PZH_PYTHON=/path/to/python3 ./run doctor

  Tried: \$PZH_PYTHON, .venv, python3.14 ... python3.10, python3, python, py,
  and any pyenv versions under \$HOME/.pyenv/versions.

EOF
    exit 1
}

# pytest is the only hard dependency. Install it once, quietly, if absent.
if ! "$PY" -c 'import pytest' >/dev/null 2>&1; then
    echo "  pytest is missing - installing it once with $PY ..."
    if ! "$PY" -m pip install --quiet pytest >/dev/null 2>&1; then
        # Distro-managed and system Pythons often refuse a plain install.
        "$PY" -m pip install --quiet --user pytest >/dev/null 2>&1 || {
            cat >&2 <<EOF

  Could not install pytest automatically.

  Try one of these, then re-run:
    $PY -m pip install --user pytest
    $PY -m venv .venv && . .venv/bin/activate && pip install pytest

  SETUP.md section 3 covers the error messages pip can give you here.

EOF
            exit 1
        }
    fi
fi

# `./run notebook` is the only argument that does not go to the grader: it is a
# different front end onto the same course. Nothing in a notebook is graded, so
# JupyterLab and friends stay optional and are installed on first use.
if [ "${1:-}" = "notebook" ]; then
    shift

    if ! "$PY" -c 'import jupyterlab' >/dev/null 2>&1; then
        echo "  JupyterLab is missing - installing the notebook extras once with $PY ..."
        if ! "$PY" -m pip install --quiet -r requirements-notebooks.txt >/dev/null 2>&1; then
            # Same story as pytest above: system Pythons often refuse a plain install.
            "$PY" -m pip install --quiet --user -r requirements-notebooks.txt >/dev/null 2>&1 || {
                cat >&2 <<EOF

  Could not install the notebook extras automatically.

  Try one of these, then re-run:
    $PY -m pip install --user -r requirements-notebooks.txt
    $PY -m venv .venv && . .venv/bin/activate && pip install -r requirements-notebooks.txt

  You do not need any of this to take the course - the graded work is
  exercises.py plus ./run dayNN, which only needs pytest.

EOF
                exit 1
            }
        fi
    fi

    # Flags a container needs: listen on all interfaces so a forwarded port
    # works, do not try to open a browser that isn't there, and root the file
    # browser at the course folder rather than wherever you happened to be.
    JUPYTER_FLAGS=(--ip=0.0.0.0 --port=8888 --no-browser "--ServerApp.root_dir=$HERE")

    # Codespaces runs you as a normal user, but plenty of plain Docker images put
    # you at root, and Jupyter refuses to start there without being told.
    if [ "$(id -u 2>/dev/null)" = "0" ]; then
        JUPYTER_FLAGS+=(--allow-root)
    fi

    # An optional day, spelled however check.py accepts it: day05, 05, 5.
    if [ $# -gt 0 ]; then
        want="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
        want="${want#day}"
        case "$want" in
            ''|*[!0-9]*)
                cat >&2 <<EOF

  Don't know which notebook '$1' means.

  Try:  ./run notebook day05   |   ./run notebook   (opens the file browser)

EOF
                exit 1
                ;;
        esac
        num="$(printf '%02d' "$((10#$want))")"

        # The build script names them notebooks/dayNN_slug.ipynb, and we do not
        # want to hardcode 21 slugs, so glob for the day number.
        nb=""
        for candidate in notebooks/day"$num"_*.ipynb; do
            [ -f "$candidate" ] && nb="$candidate" && break
        done

        if [ -z "$nb" ]; then
            cat >&2 <<EOF

  No notebook for day $num yet (looked for notebooks/day${num}_*.ipynb).

  The notebooks are generated from each day's LESSON.md. Build them with:

    $PY tools/build_notebooks.py

  Then re-run:  ./run notebook day$num

  Or read the lesson as plain text - it is the same content:
    course/week*/day${num}_*/LESSON.md

EOF
            exit 1
        fi

        # The positional path opens the notebook when there is a browser to open
        # it in; default_url is what makes it work in a container, where you
        # arrive at "/" from a forwarded port and want to land in the lesson.
        exec "$PY" -m jupyterlab "${JUPYTER_FLAGS[@]}" \
            "--LabApp.default_url=/lab/tree/$nb" "$nb"
    fi

    exec "$PY" -m jupyterlab "${JUPYTER_FLAGS[@]}"
fi

# Tell check.py how you invoked it, so its hints say "./run day05" rather than
# "python check.py day05".
export PZH_LAUNCHER="./run"

exec "$PY" check.py "$@"
